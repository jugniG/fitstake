# Copy to .env and fill in. Sandbox-first; switch KELVIQ_ENV to production to go live.

# ── Database (Neon or Supabase Postgres) ──
# The schema parameter is required: the app looks for tables in this schema.
DATABASE_URL=postgresql://user:password@host.neon.tech/kiroween?schema=stakefit&sslmode=require

# ── Better Auth ──
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32
# Google OAuth — Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic-link email transport (Resend). Leave blank to log the link to the server console in dev.
RESEND_API_KEY=
RESEND_FROM=Habit-Stakes <onboarding@yourdomain.com>
# Public app URL used for auth callbacks, magic-link URLs, and Kelviq successUrl.
APP_URL=http://localhost:3000

# ── Kelviq (merchant of record) ──
KELVIQ_SERVER_API_KEY=
KELVIQ_WEBHOOK_SECRET=
KELVIQ_ENV=sandbox
# Identifier of the one-time plan you create in the Kelviq dashboard for commitment charges.
KELVIQ_COMMITMENT_PLAN_IDENTIFIER=
# App access. Both plans must be separate from the commitment plan.
# $2/week recurring plan. The 3-day trial is applied per checkout session, so the plan needs no
# trial setting.
KELVIQ_SUBSCRIPTION_PLAN_IDENTIFIER=
# $49 one-time lifetime plan.
KELVIQ_LIFETIME_PLAN_IDENTIFIER=
