# Copy to .env and fill in. Use a Dodo test key and test products while developing.

# ── Database (Neon or Supabase Postgres) ──
# The schema parameter is required: the app looks for tables in this schema.
DATABASE_URL=postgresql://user:password@host/db?schema=stakefit&sslmode=require

# ── Better Auth ──
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32
# Google OAuth — Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic-link email transport (Resend). Leave blank to log the link to the server console in dev.
RESEND_API_KEY=
RESEND_FROM=StakeFit <onboarding@yourdomain.com>
# Public app URL used for auth callbacks, magic-link URLs, and Dodo return URLs.
APP_URL=http://localhost:3000

# ── Dodo Payments (merchant of record) ──
# test_mode or live_mode. The API key and product ids must come from the same mode.
DODO_MODE=test_mode
# Dodo dashboard -> Developer -> API Keys
DODO_API_KEY=
# Dodo dashboard -> Developer -> Webhooks -> endpoint <APP_URL>/api/webhooks/dodo -> signing secret
DODO_WEBHOOK_SECRET=
# $2/week subscription product (no trial on the product; the app adds 3 days for first-timers)
DODO_WEEKLY_PRODUCT_ID=
# $49 one-time product (lifetime for users who already used their trial)
DODO_LIFETIME_PRODUCT_ID=
# Subscription product used only for the lifetime 3-day trial mandate; the app charges $49 when
# the trial ends
DODO_LIFETIME_TRIAL_PRODUCT_ID=
# Subscription product used only for on-demand stake mandates (missed days are charged on demand)
DODO_STAKE_PRODUCT_ID=
# Protects /api/cron/charge-missed (any long random string)
CRON_SECRET=
